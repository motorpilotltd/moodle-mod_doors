<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/doors/db" VERSION="20260905" COMMENT="XMLDB file for Moodle mod_doors"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="doors" COMMENT="One record per door calendar activity instance">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="printintro" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="numdoors" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="24" SEQUENCE="false"/>
        <FIELD NAME="layout" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="grid" SEQUENCE="false"/>
        <FIELD NAME="gridcols" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="6" SEQUENCE="false"/>
        <FIELD NAME="maxwidth" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="doorshape" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="rounded" SEQUENCE="false"/>
        <FIELD NAME="aspect" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="square" SEQUENCE="false"/>
        <FIELD NAME="bgcolour" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="doorcolour" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="doortextcolour" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="openedcolour" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="colourmode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="fixed" SEQUENCE="false"/>
        <FIELD NAME="palette" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="shownumbers" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="showtitles" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="showactivityicon" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="buttonstyle" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="theme" SEQUENCE="false"/>
        <FIELD NAME="randomise" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="openmode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="any" SEQUENCE="false"/>
        <FIELD NAME="reopen" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="markopened" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="openedstyle" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="flip" SEQUENCE="false"/>
        <FIELD NAME="showprogress" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="customcss" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="completionopened" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="doors_door" COMMENT="One record per door within a calendar">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="doorsid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="doornumber" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="doorlabel" TYPE="char" LENGTH="40" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="contentformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="linkurl" TYPE="char" LENGTH="1333" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="linktext" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="linkmode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="link" SEQUENCE="false"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="mediaposition" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="above" SEQUENCE="false"/>
        <FIELD NAME="linknewwindow" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="availablefrom" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="doorcolour" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="posx" TYPE="number" LENGTH="7" DECIMALS="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="posy" TYPE="number" LENGTH="7" DECIMALS="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="poswidth" TYPE="number" LENGTH="7" DECIMALS="3" NOTNULL="true" DEFAULT="12" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="doorsid" TYPE="foreign" FIELDS="doorsid" REFTABLE="doors" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="doorsid-doornumber" UNIQUE="true" FIELDS="doorsid, doornumber"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="doors_opened" COMMENT="Records which doors a user has opened">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="doorsid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="doorid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeopened" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="doorsid" TYPE="foreign" FIELDS="doorsid" REFTABLE="doors" REFFIELDS="id"/>
        <KEY NAME="doorid" TYPE="foreign" FIELDS="doorid" REFTABLE="doors_door" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="doorid-userid" UNIQUE="true" FIELDS="doorid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
